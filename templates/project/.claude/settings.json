{
  "extraKnownMarketplaces": {
    "rockbuilt": {
      "source": {
        "source": "github",
        "repo": "ragarciaga/rockbuilt"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "rockbuilt@rockbuilt": true
  },
  "permissions": {
    "allow": [
      "Bash(rb *)",
      "Bash(gh auth status*)",
      "Bash(gh repo view*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue create*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue edit*)",
      "Bash(gh label list*)",
      "Bash(gh label create*)",
      "Bash(gh label edit*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git merge-base*)",
      "Bash(git blame*)",
      "Bash(git grep*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git worktree*)",
      "Bash(git -C *)",
      "Bash(git reset --soft*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Edit",
      "Write",
      "Bash(node *scripts/rb.mjs*)",
      "mcp__playwright"
    ],
    "ask": [
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin HEAD:master*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -D master*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push origin main*)",
      "Bash(git -C * push origin master*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * clean*)"
    ]
  }
}
