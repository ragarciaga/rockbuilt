{
  "about": "Headless-runnable eval scenarios. Each one maps to a scenario in evals/<skill>.md. Run with: node evals/run.mjs [ids...] [--arms with,without] [--parallel 3]",
  "scenarios": [
    {
      "id": "kickoff-s1-vague-es",
      "source": "kickoff.md#S1",
      "setup": [],
      "prompt": "Quiero crear una app para mis finanzas personales.",
      "arms": [
        "with",
        "without"
      ],
      "checks": [
        {
          "type": "skill",
          "name": "rockbuilt:kickoff"
        },
        {
          "type": "noFilesCreated"
        },
        {
          "type": "finalLanguage",
          "lang": "es"
        },
        {
          "type": "noEmDash"
        }
      ]
    },
    {
      "id": "kickoff-s3-existing-code",
      "source": "kickoff.md#S3 (either kickoff or adopt may load; both must ask before writing)",
      "setup": [
        "node-app"
      ],
      "prompt": "Arranquemos un proyecto nuevo aquí: quiero construir la versión 2 de esta app de gastos.",
      "checks": [
        {
          "type": "worktreeClean"
        },
        {
          "type": "noCommits"
        },
        {
          "type": "finalMatches",
          "pattern": "(?i)adopt|carpeta nueva|nueva carpeta|carpeta vac|evolucionar|evolucione|aparte|independiente"
        },
        {
          "type": "noEmDash"
        }
      ]
    },
    {
      "id": "kickoff-s4-no-trigger",
      "source": "kickoff.md#S4",
      "setup": [],
      "prompt": "Explícame qué es un walking skeleton y por qué se hace primero.",
      "checks": [
        {
          "type": "noRockbuiltSkill"
        },
        {
          "type": "noFilesCreated"
        }
      ]
    },
    {
      "id": "adopt-s1-green-es",
      "source": "adopt.md#S1",
      "setup": [
        "node-app"
      ],
      "prompt": "Ya tengo un proyecto, adopta este repo. Quiero agregarle presupuestos mensuales por categoría.",
      "checks": [
        {
          "type": "skill",
          "name": "rockbuilt:adopt"
        },
        {
          "type": "agentsInclude",
          "agents": [
            "rockbuilt:scout"
          ]
        },
        {
          "type": "fileExists",
          "path": "docs/current-state.md"
        },
        {
          "type": "noChangesUnder",
          "paths": [
            "src/",
            "tests/",
            "package.json"
          ]
        },
        {
          "type": "noCommits"
        },
        {
          "type": "noEmDash"
        }
      ]
    },
    {
      "id": "fix-s1-es",
      "source": "fix.md#S1",
      "setup": [
        "node-app",
        "harness-es"
      ],
      "prompt": "Hay un bug: en el reporte de octubre \"Comida\" y \"comida\" salen como dos categorías distintas. Arréglalo. Para reproducir: node src/cli.js sample-expenses.json 2026-10, esperaba una sola fila comida con 205000.",
      "arms": [
        "with",
        "without"
      ],
      "checks": [
        {
          "type": "skill",
          "name": "rockbuilt:fix"
        },
        {
          "type": "agentsInclude",
          "agents": [
            "rockbuilt:implementer",
            "rockbuilt:verifier"
          ]
        },
        {
          "type": "noMainSessionWrites",
          "paths": [
            "src/",
            "tests/"
          ]
        },
        {
          "type": "defaultBranchUnchanged"
        },
        {
          "type": "oneCommitOnRbBranch"
        },
        {
          "type": "noEmDash"
        }
      ]
    },
    {
      "id": "fix-s3-feature-not-bug",
      "source": "fix.md#S3",
      "setup": [
        "node-app",
        "harness-es"
      ],
      "prompt": "Esto está roto: la CLI no me deja exportar a CSV.",
      "arms": [
        "with",
        "without"
      ],
      "checks": [
        {
          "type": "finalMatches",
          "pattern": "rockbuilt:spec|/spec"
        },
        {
          "type": "worktreeClean"
        },
        {
          "type": "noCommits"
        }
      ]
    },
    {
      "id": "fix-s4-no-trigger",
      "source": "fix.md#S4",
      "setup": [
        "node-app",
        "harness-es"
      ],
      "prompt": "¿Cómo leo el output de node --test cuando falla una prueba?",
      "checks": [
        {
          "type": "noRockbuiltSkill"
        },
        {
          "type": "worktreeClean"
        }
      ]
    },
    {
      "id": "build-s2-red-baseline",
      "source": "build.md#S2",
      "setup": [
        "node-app",
        "harness-es",
        "red-baseline",
        "spec-approved",
        "tasks-approved"
      ],
      "prompt": "Construye todas las tareas de docs/specs/01-monthly-budgets.",
      "checks": [
        {
          "type": "skill",
          "name": "rockbuilt:build"
        },
        {
          "type": "agentsExclude",
          "agents": [
            "rockbuilt:implementer"
          ]
        },
        {
          "type": "noCommits"
        },
        {
          "type": "finalMatches",
          "pattern": "(?i)rojo|red|baseline|línea base"
        }
      ]
    }
  ]
}
