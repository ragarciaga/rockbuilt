{
  "permissions": {
    "allow": [
      "Shell(node:tools/rockbuilt/rb.mjs *)",
      "Shell(git:status*)",
      "Shell(git:diff*)",
      "Shell(git:log*)",
      "Shell(git:show*)",
      "Shell(git:rev-parse*)",
      "Shell(git:ls-files*)",
      "Shell(git:merge-base*)",
      "Shell(git:blame*)",
      "Shell(git:grep*)",
      "Shell(git:add*)",
      "Shell(git:commit*)",
      "Shell(git:switch*)",
      "Shell(git:checkout -b*)",
      "Shell(git:branch*)",
      "Shell(git:fetch*)",
      "Shell(git:pull*)",
      "Shell(git:push*)",
      "Shell(git:worktree*)",
      "Shell(git:reset --soft*)",
      "Shell(git:stash list*)",
      "Shell(npm:run *)",
      "Shell(npm:test*)",
      "Shell(npm:ci*)",
      "Shell(npm:install*)",
      "Shell(npx:playwright *)",
      "Shell(node:--test*)",
      "Mcp(playwright:*)",
      "Write(**)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Shell(git:push --force*)",
      "Shell(git:push -f*)",
      "Shell(git:push -uf*)",
      "Shell(git:push --force-with-lease*)",
      "Shell(git:push * --force*)",
      "Shell(git:push * -f*)",
      "Shell(git:push * -uf*)",
      "Shell(git:push * +*)",
      "Shell(git:-C * push*)",
      "Shell(git:push origin main*)",
      "Shell(git:push origin master*)",
      "Shell(git:push origin HEAD:main*)",
      "Shell(git:push origin HEAD:master*)",
      "Shell(git:push --all*)",
      "Shell(git:push --mirror*)",
      "Shell(git:push * --all*)",
      "Shell(git:push * --mirror*)",
      "Shell(git:reset --hard*)",
      "Shell(git:-C * reset --hard*)",
      "Shell(git:clean*)",
      "Shell(git:-C * clean*)",
      "Shell(git:checkout -- .*)",
      "Shell(git:restore .*)",
      "Shell(git:branch -D main*)",
      "Shell(git:branch -D master*)",
      "Shell(rm:-rf*)",
      "Shell(rm:-r -f*)",
      "Shell(rm:-fr*)",
      "Shell(rm:-Rf*)",
      "Shell(npm:exec*)",
      "Shell(gh:pr merge*)"
    ]
  }
}
