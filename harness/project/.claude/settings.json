{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/rockbuilt/guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node tools/rockbuilt/rb.mjs *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git merge-base*)",
      "Bash(git blame*)",
      "Bash(git grep*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git checkout -b*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git worktree*)",
      "Bash(git reset --soft*)",
      "Bash(git stash list*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npx playwright *)",
      "Bash(node --test*)",
      "mcp__playwright",
      "Edit",
      "Write"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(**/.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push -uf*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * -uf*)",
      "Bash(git push * +*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push * +*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin HEAD:master*)",
      "Bash(git -C * push origin main*)",
      "Bash(git -C * push origin master*)",
      "Bash(git push --all*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --all*)",
      "Bash(git push * --mirror*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean*)",
      "Bash(git -C * clean*)",
      "Bash(git checkout -- .*)",
      "Bash(git restore .*)",
      "Bash(git -C * restore .*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -D master*)",
      "Bash(rm -rf*)",
      "Bash(rm -r -f*)",
      "Bash(rm -fr*)",
      "Bash(rm -Rf*)",
      "Bash(rm -fR*)",
      "Bash(npm exec*)",
      "Bash(gh pr merge*)"
    ]
  }
}
